#!/bin/sh
# cmux plugin-manager entrypoint: run the Rust sidebar subcommand.
set -eu

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  LINK=$(readlink "$SCRIPT") || exit 1
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$SCRIPT_DIR/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd)
BINARY="$ROOT/.cmux-herdr/bin/cmux-herdr"

if [ ! -x "$BINARY" ]; then
  "$ROOT/bin/cmux-herdr-fetch"
fi
[ -x "$BINARY" ] || {
  printf 'cmux-herdr-sidebar: runtime binary is missing after bootstrap: %s\n' "$BINARY" >&2
  exit 1
}
exec "$BINARY" sidebar "$@"
