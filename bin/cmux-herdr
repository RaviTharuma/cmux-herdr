#!/usr/bin/env python3
"""cmux-herdr — user-controlled bridge CLI (no cmux upstream PR required).

Expose herdr tabs/panes/agents to cmux via status pills + local control.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import sys
import time
from pathlib import Path
from typing import List, Optional

# Allow running from repo without install: add bridge/ parent to path
_ROOT = Path(__file__).resolve().parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from bridge.cmux_herdr_bridge import (  # noqa: E402
    BridgeError,
    _load_association_map,
    clear_cmux_herdr_statuses,
    diagnose_install,
    dual_status,
    fetch_agents,
    fetch_snapshot,
    focus_agent,
    focus_pane,
    focus_tab,
    focus_workspace,
    format_associations,
    format_tree,
    herdr_available,
    read_agent,
    read_pane,
    resolve_cmux_workspace,
    split_pane,
    sync_to_cmux,
)
from bridge.cmux_herdr_mirror import (  # noqa: E402
    attach_pane_loop,
    format_mirror_plan,
    is_attach_process,
    mirror_to_cmux,
)

__version__ = "0.1.0"


def _read_version() -> str:
    """Return package version from VERSION (source of truth) with a safe fallback."""
    version_file = _ROOT / "VERSION"
    try:
        text = version_file.read_text(encoding="utf-8").strip()
        if text:
            return text
    except OSError:
        pass
    return __version__


def _die(msg: str, code: int = 1) -> None:
    print(f"cmux-herdr: {msg}", file=sys.stderr)
    raise SystemExit(code)


def _ensure_herdr() -> None:
    if not herdr_available():
        _die(
            "herdr not available (HERDR_ENV unset and socket/CLI unhealthy). "
            "Run inside a herdr pane or start herdr."
        )


def cmd_status(_args: argparse.Namespace) -> int:
    info = dual_status()
    # Human-readable
    print("cmux-herdr status")
    print("─────────────────")
    nested = "yes" if info.get("nested") else "no"
    print(f"nested context : {nested}")
    h = info["herdr"]
    print("herdr:")
    print(f"  available    : {h.get('available')}")
    print(f"  cli          : {h.get('cli')}")
    print(f"  env          : {h.get('env')}")
    print(f"  workspace    : {h.get('workspace_id')}")
    print(f"  tab          : {h.get('tab_id')}")
    print(f"  pane         : {h.get('pane_id')}")
    print(f"  socket       : {h.get('socket_path')} (exists={h.get('socket_exists')})")
    print(f"  server pid   : {h.get('server_pid') or '-'}")
    if h.get("pane_count") is not None:
        print(
            f"  topology     : workspaces={h.get('workspace_count')} "
            f"tabs={h.get('tab_count')} panes={h.get('pane_count')} "
            f"agents={h.get('agent_count')}"
        )
        print(f"  statuses     : {h.get('status_counts')}")
    if h.get("error"):
        print(f"  error        : {h['error']}")
    c = info["cmux"]
    print("cmux:")
    print(f"  available    : {c.get('available')}")
    print(f"  cli          : {c.get('cli')}")
    print(f"  env workspace: {c.get('workspace_id')}")
    print(f"  env tab      : {c.get('tab_id')}")
    print(f"  env surface  : {c.get('surface_id')}")
    print(f"  socket       : {c.get('socket_path')} (exists={c.get('socket_exists')})")
    print(f"  resolved ws  : {c.get('resolved_workspace')}")
    if c.get("resolve_error"):
        print(f"  resolve err  : {c['resolve_error']}")
    print("host fingerprint:")
    print(f"  key          : {info.get('host_fingerprint_key') or '-'}")
    missing = info.get("host_fingerprint_missing") or []
    print(f"  missing      : {', '.join(missing) if missing else '(none)'}")
    if _args.json:
        print(json.dumps(info, indent=2, default=str))
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    """Diagnose third-party install; exit non-zero on hard failures."""
    report = diagnose_install()
    print("cmux-herdr doctor")
    print("─────────────────")
    for check in report.get("checks") or []:
        name = check.get("name") or "?"
        ok = bool(check.get("ok"))
        hard = bool(check.get("hard"))
        if ok:
            mark = "ok"
        elif hard:
            mark = "FAIL"
        else:
            mark = "warn"
        print(f"[{mark:4}] {name}: {check.get('detail')}")
    if report.get("hard_failures"):
        print()
        print("hard failures:")
        for item in report["hard_failures"]:
            print(f"  - {item}")
    if args.json:
        print(json.dumps(report, indent=2, default=str))
    return 0 if report.get("ok") else 1


def cmd_tree(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        snap = fetch_snapshot()
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(
            json.dumps(
                {
                    "workspaces": [w.raw for w in snap.workspaces],
                    "tabs": [t.raw for t in snap.tabs],
                    "panes": [p.raw for p in snap.panes],
                },
                indent=2,
                default=str,
            )
        )
    else:
        print(format_tree(snap))
    return 0


def cmd_sync(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        summary = sync_to_cmux(
            workspace=args.workspace,
            clear_stale=not args.no_clear_stale,
            set_progress=not args.no_progress,
            log=not args.no_log,
        )
    except BridgeError as exc:
        _die(str(exc))
    print(summary["summary"])
    if summary.get("stale_cleared"):
        print(f"cleared stale: {', '.join(summary['stale_cleared'])}")
    if summary.get("errors"):
        for e in summary["errors"]:
            print(f"error: {e}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(summary, indent=2, default=str))
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    if args.once:
        if getattr(args, "mirror", False):
            return cmd_mirror(args)
        return cmd_sync(args)
    _ensure_herdr()
    interval = max(0.5, float(args.interval))
    stop = {"flag": False}

    def _handle(signum, frame):  # noqa: ARG001
        stop["flag"] = True
        print("\ncmux-herdr watch: stopping…", file=sys.stderr)

    signal.signal(signal.SIGINT, _handle)
    signal.signal(signal.SIGTERM, _handle)
    mode = "mirror+status" if getattr(args, "mirror", False) else "status"
    print(
        f"cmux-herdr watch: {mode} every {interval}s "
        f"(workspace={args.workspace or 'auto'}); Ctrl-C to stop",
        file=sys.stderr,
    )
    while not stop["flag"]:
        try:
            if getattr(args, "mirror", False):
                result = mirror_to_cmux(
                    scope=_mirror_scope(args),
                    workspace=args.workspace,
                    herdr_workspace=getattr(args, "herdr_workspace", None),
                    tab=getattr(args, "tab", None),
                    prune=getattr(args, "prune", False),
                    dry_run=False,
                    sync_status=not args.no_progress,
                    log=False,
                )
                print(format_mirror_plan(result).splitlines()[0])
            else:
                summary = sync_to_cmux(
                    workspace=args.workspace,
                    clear_stale=not args.no_clear_stale,
                    set_progress=not args.no_progress,
                    log=False,  # avoid log spam
                )
                print(summary["summary"])
        except BridgeError as exc:
            print(f"cmux-herdr: {exc}", file=sys.stderr)
        except Exception as exc:  # noqa: BLE001
            print(f"cmux-herdr: unexpected: {exc}", file=sys.stderr)
        # Sleep in small slices so SIGINT is responsive
        end = time.time() + interval
        while not stop["flag"] and time.time() < end:
            time.sleep(min(0.25, end - time.time()))
    return 0


def _mirror_scope(args: argparse.Namespace) -> str:
    if getattr(args, "all", False):
        return "all"
    if getattr(args, "herdr_workspace", None):
        return "workspace"
    return "current-tab"


def cmd_mirror(args: argparse.Namespace) -> int:
    if is_attach_process():
        _die("refusing to nest mirror inside attach-pane")
    _ensure_herdr()
    try:
        result = mirror_to_cmux(
            scope=_mirror_scope(args),
            workspace=args.workspace,
            herdr_workspace=getattr(args, "herdr_workspace", None),
            tab=getattr(args, "tab", None),
            prune=getattr(args, "prune", False),
            dry_run=getattr(args, "dry_run", False),
            sync_status=not getattr(args, "no_status", False),
            log=not getattr(args, "no_log", False),
        )
    except BridgeError as exc:
        _die(str(exc))
    print(format_mirror_plan(result))
    plan = result.get("plan") if isinstance(result.get("plan"), dict) else {}
    if args.json:
        print(json.dumps(result, indent=2, default=str))
    if plan.get("errors"):
        return 2
    return 0


def cmd_attach_pane(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        return attach_pane_loop(
            args.pane_id,
            interval=max(0.05, float(args.interval)),
            lines=args.lines,
            send_input=not args.read_only,
        )
    except KeyboardInterrupt:
        print("\ncmux-herdr: detached viewer", file=sys.stderr)
        return 0
    except BridgeError as exc:
        _die(str(exc))
    return 1


def cmd_focus_tab(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        tid = focus_tab(args.target)
    except BridgeError as exc:
        _die(str(exc))
    print(f"focused tab {tid}")
    return 0


def cmd_focus_pane(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        pid = focus_pane(args.pane_id)
    except BridgeError as exc:
        _die(str(exc))
    print(f"focused pane {pid}")
    return 0


def cmd_focus_workspace(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        wid = focus_workspace(args.workspace_id)
    except BridgeError as exc:
        _die(str(exc))
    print(f"focused workspace {wid}")
    return 0


def cmd_focus_agent(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        target = focus_agent(args.target)
    except BridgeError as exc:
        _die(str(exc))
    print(f"focused agent {target}")
    return 0


def _passthrough_read(proc) -> int:
    """Write herdr read stdout/stderr and return its exit code."""
    if proc.stdout:
        sys.stdout.write(proc.stdout)
        if not proc.stdout.endswith("\n"):
            sys.stdout.write("\n")
    if proc.stderr:
        sys.stderr.write(proc.stderr)
        if not proc.stderr.endswith("\n"):
            sys.stderr.write("\n")
    code = int(proc.returncode or 0)
    return code if code != 0 else 0


def cmd_read_pane(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        proc = read_pane(
            args.pane_id,
            source=args.source,
            lines=args.lines,
            format=args.format,
            ansi=args.ansi,
            raw=args.raw,
        )
    except BridgeError as exc:
        _die(str(exc))
    return _passthrough_read(proc)


def cmd_read_agent(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        proc = read_agent(
            args.target,
            source=args.source,
            lines=args.lines,
            format=args.format,
            ansi=args.ansi,
        )
    except BridgeError as exc:
        _die(str(exc))
    return _passthrough_read(proc)


def cmd_split(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        result = split_pane(args.direction)
    except BridgeError as exc:
        _die(str(exc))
    if isinstance(result, (dict, list)):
        print(json.dumps(result, indent=2, default=str))
    else:
        print(result)
    return 0


def cmd_agents(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        agents = fetch_agents()
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(json.dumps([a.raw for a in agents], indent=2, default=str))
        return 0
    if not agents:
        print("(no agents)")
        return 0
    for a in agents:
        mark = "▶" if a.focused else " "
        label = a.label or ""
        print(
            f"{mark} {a.pane_id:10}  {a.tab_id:8}  "
            f"{(a.agent or '-'):10}  {(a.agent_status or '?'):8}  "
            f"{label or (a.terminal_title or '')[:40]}"
        )
    return 0


def cmd_associations(args: argparse.Namespace) -> int:
    """Show hybrid pane/session association cache for this Herdr+cmux parent."""
    state = _load_association_map()
    if args.json:
        print(json.dumps(state, indent=2, default=str))
    else:
        print(format_associations(state))
    return 0


def cmd_clear(args: argparse.Namespace) -> int:
    try:
        cleared = clear_cmux_herdr_statuses(args.workspace)
    except BridgeError as exc:
        _die(str(exc))
    if cleared:
        print(f"cleared {len(cleared)} status keys:")
        for k in cleared:
            print(f"  {k}")
    else:
        print("no herdr:* status keys to clear")
    return 0


def cmd_json_dump(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        snap = fetch_snapshot()
    except BridgeError as exc:
        _die(str(exc))
    payload = {
        "fetched_at": snap.fetched_at,
        "env": {
            "HERDR_ENV": os.environ.get("HERDR_ENV"),
            "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
            "HERDR_TAB_ID": os.environ.get("HERDR_TAB_ID"),
            "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
            "HERDR_SOCKET_PATH": os.environ.get("HERDR_SOCKET_PATH"),
            "CMUX_SURFACE_ID": os.environ.get("CMUX_SURFACE_ID"),
            "CMUX_TAB_ID": os.environ.get("CMUX_TAB_ID"),
            "CMUX_WORKSPACE_ID": os.environ.get("CMUX_WORKSPACE_ID"),
            "CMUX_SOCKET_PATH": os.environ.get("CMUX_SOCKET_PATH"),
        },
        "cmux_resolved_workspace": None,
        "workspaces": [w.raw for w in snap.workspaces],
        "tabs": [t.raw for t in snap.tabs],
        "panes": [p.raw for p in snap.panes],
    }
    try:
        payload["cmux_resolved_workspace"] = resolve_cmux_workspace()
    except Exception as exc:  # noqa: BLE001
        payload["cmux_resolve_error"] = str(exc)
    print(json.dumps(payload, indent=2, default=str))
    return 0


def _add_read_flags(sp: argparse.ArgumentParser, *, include_raw: bool) -> None:
    """Shared flags for read-pane / read-agent (herdr pass-through)."""
    sp.add_argument(
        "--source",
        choices=("visible", "recent", "recent-unwrapped", "detection"),
        help="herdr read source (default: herdr's own default)",
    )
    sp.add_argument(
        "--lines",
        type=int,
        help="limit to last N lines/rows (herdr --lines)",
    )
    sp.add_argument(
        "--format",
        choices=("text", "ansi"),
        help="output format (herdr --format)",
    )
    sp.add_argument(
        "--ansi",
        action="store_true",
        help="preserve ANSI (herdr --ansi)",
    )
    if include_raw:
        sp.add_argument(
            "--raw",
            action="store_true",
            help="raw ANSI without stripping (herdr pane read --raw)",
        )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cmux-herdr",
        description="Bridge herdr agent/tab state into cmux (user plugin, no upstream PR).",
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"cmux-herdr {_read_version()}",
    )
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("status", help="Show dual cmux+herdr context")
    s.add_argument("--json", action="store_true", help="Also print raw JSON blob")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser(
        "doctor",
        help="Diagnose third-party install (herdr, socket, fingerprint, LaunchAgent, sidebar)",
    )
    s.add_argument("--json", action="store_true", help="Also print raw JSON report")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("tree", help="Pretty-print herdr workspaces/tabs/panes/agents")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_tree)

    def add_sync_flags(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--workspace",
            help="cmux workspace id/ref (default: auto-resolve)",
        )
        sp.add_argument(
            "--no-clear-stale",
            action="store_true",
            help="Do not remove herdr:* keys for gone panes",
        )
        sp.add_argument(
            "--no-progress",
            action="store_true",
            help="Do not update cmux set-progress",
        )
        sp.add_argument(
            "--no-log",
            action="store_true",
            help="Do not cmux log summary line",
        )
        sp.add_argument("--json", action="store_true")

    def add_mirror_flags(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--all",
            action="store_true",
            help="Mirror every Herdr tab/pane (ssh-tmux-style full session)",
        )
        sp.add_argument(
            "--herdr-workspace",
            help="Mirror every tab in this Herdr workspace id (e.g. w2)",
        )
        sp.add_argument(
            "--tab",
            help="Herdr tab id to mirror (default: $HERDR_TAB_ID)",
        )
        sp.add_argument(
            "--prune",
            action="store_true",
            help="Close cmux surfaces whose Herdr panes are gone",
        )
        sp.add_argument(
            "--dry-run",
            action="store_true",
            help="Print the reconcile plan without creating/closing surfaces",
        )
        sp.add_argument(
            "--no-status",
            action="store_true",
            help="Do not also write herdr:* status pills",
        )

    s = sub.add_parser("sync", help="One-shot mirror herdr agents → cmux set-status")
    add_sync_flags(s)
    s.set_defaults(func=cmd_sync)

    s = sub.add_parser("watch", help="Loop sync every N seconds (default 3)")
    add_sync_flags(s)
    add_mirror_flags(s)
    s.add_argument(
        "-n",
        "--interval",
        type=float,
        default=3.0,
        help="Seconds between syncs (default 3)",
    )
    s.add_argument(
        "--once",
        action="store_true",
        help="Alias for sync (single iteration)",
    )
    s.add_argument(
        "--mirror",
        action="store_true",
        help="Also reconcile Herdr tabs/panes into cmux tabs/splits",
    )
    s.set_defaults(func=cmd_watch)

    s = sub.add_parser(
        "mirror",
        help="Project Herdr tabs/panes into real cmux tabs/splits (userspace ssh-tmux analogue)",
    )
    add_sync_flags(s)
    add_mirror_flags(s)
    s.set_defaults(func=cmd_mirror)

    s = sub.add_parser(
        "attach-pane",
        help="Follow one Herdr pane in this terminal (used by mirror surfaces)",
    )
    s.add_argument("pane_id")
    s.add_argument(
        "-n",
        "--interval",
        type=float,
        default=0.25,
        help="Refresh interval seconds (default 0.25)",
    )
    s.add_argument(
        "--lines",
        type=int,
        default=200,
        help="Lines to read from herdr pane read (default 200)",
    )
    s.add_argument(
        "--read-only",
        action="store_true",
        help="Do not forward typed input to the Herdr pane",
    )
    s.set_defaults(func=cmd_attach_pane)

    s = sub.add_parser("focus-tab", help="Focus herdr tab by id or label")
    s.add_argument("target", help="tab_id or label")
    s.set_defaults(func=cmd_focus_tab)

    s = sub.add_parser(
        "focus-pane",
        help="Focus herdr pane by id (via herdr agent focus; no zoom fallback)",
    )
    s.add_argument("pane_id")
    s.set_defaults(func=cmd_focus_pane)

    s = sub.add_parser("focus-workspace", help="Focus herdr workspace by id")
    s.add_argument("workspace_id")
    s.set_defaults(func=cmd_focus_workspace)

    s = sub.add_parser("focus-agent", help="Focus herdr agent by pane id or label")
    s.add_argument("target", help="pane_id or agent label")
    s.set_defaults(func=cmd_focus_agent)

    s = sub.add_parser(
        "read-pane",
        help="Read herdr pane output (thin wrapper over herdr pane read)",
    )
    s.add_argument("pane_id")
    _add_read_flags(s, include_raw=True)
    s.set_defaults(func=cmd_read_pane)

    s = sub.add_parser(
        "read-agent",
        help="Read herdr agent output (thin wrapper over herdr agent read)",
    )
    s.add_argument("target", help="pane_id or agent label")
    _add_read_flags(s, include_raw=False)
    s.set_defaults(func=cmd_read_agent)

    s = sub.add_parser("split", help="Split current herdr pane")
    s.add_argument(
        "--direction",
        choices=("right", "down"),
        default="right",
    )
    s.set_defaults(func=cmd_split)

    s = sub.add_parser("agents", help="List herdr agents compactly")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_agents)

    s = sub.add_parser(
        "associations",
        help="Show hybrid pane/session association cache (parent map + status keys)",
    )
    s.add_argument("--json", action="store_true", help="machine-readable output")
    s.set_defaults(func=cmd_associations)

    s = sub.add_parser("clear", help="Clear all cmux statuses with herdr: prefix")
    s.add_argument("--workspace", help="cmux workspace id/ref")
    s.set_defaults(func=cmd_clear)

    s = sub.add_parser("json-dump", help="Raw snapshot for debugging")
    s.set_defaults(func=cmd_json_dump)

    return p


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
