__version__ = "0.1.0"


def _read_version() -> str:
    """Return package version from VERSION (source of truth) with a safe fallback."""
    version_file = _ROOT / "VERSION"
    try:
        text = version_file.read_text(encoding="utf-8").strip()
        if text:
            return text
    except OSError:
        pass
    return __version__


def _die(msg: str, code: int = 1) -> None:
    print(f"cmux-herdr: {msg}", file=sys.stderr)
    raise SystemExit(code)


def _ensure_herdr() -> None:
    if not herdr_available():
        _die(
            "herdr not available (HERDR_ENV unset and socket/CLI unhealthy). "
            "Run inside a herdr pane or start herdr."
        )


def cmd_status(_args: argparse.Namespace) -> int:
    info = dual_status()
    # Human-readable
    print("cmux-herdr status")
    print("─────────────────")
    nested = "yes" if info.get("nested") else "no"
    print(f"nested context : {nested}")
    h = info["herdr"]
    print("herdr:")
    print(f"  available    : {h.get('available')}")
    print(f"  cli          : {h.get('cli')}")
    print(f"  env          : {h.get('env')}")
    print(f"  workspace    : {h.get('workspace_id')}")
    print(f"  tab          : {h.get('tab_id')}")
    print(f"  pane         : {h.get('pane_id')}")
    print(f"  socket       : {h.get('socket_path')} (exists={h.get('socket_exists')})")
    print(f"  server pid   : {h.get('server_pid') or '-'}")
    api = h.get("api") or {}
    if api.get("ok"):
        print(f"  api          : ok via {api.get('via')}")
    elif api.get("error"):
        print(f"  api          : {api.get('error')}")
    if h.get("pane_count") is not None:
        print(
            f"  topology     : workspaces={h.get('workspace_count')} "
            f"tabs={h.get('tab_count')} panes={h.get('pane_count')} "
            f"agents={h.get('agent_count')}"
        )
        print(f"  statuses     : {h.get('status_counts')}")
    if h.get("error"):
        print(f"  error        : {h['error']}")
    c = info["cmux"]
    print("cmux:")
    print(f"  available    : {c.get('available')}")
    print(f"  cli          : {c.get('cli')}")
    print(f"  env workspace: {c.get('workspace_id')}")
    print(f"  env tab      : {c.get('tab_id')}")
    print(f"  env surface  : {c.get('surface_id')}")
    print(f"  socket       : {c.get('socket_path')} (exists={c.get('socket_exists')})")
    print(f"  resolved ws  : {c.get('resolved_workspace')}")
    if c.get("resolve_error"):
        print(f"  resolve err  : {c['resolve_error']}")
    print("host fingerprint:")
    print(f"  key          : {info.get('host_fingerprint_key') or '-'}")
    missing = info.get("host_fingerprint_missing") or []
    print(f"  missing      : {', '.join(missing) if missing else '(none)'}")
    writer = info.get("writer") or {}
    print("writer:")
    print(f"  path         : {writer.get('writer') or 'plugin'}")
    print(f"  native live  : {writer.get('native_live')}")
    print(f"  plugin live  : {writer.get('plugin_live')}")
    if writer.get("lease_stale"):
        print("  lease        : stale (other path may resume)")
    if writer.get("force_plugin"):
        print("  force plugin : yes")
    if _args.json:
        print(json.dumps(info, indent=2, default=str))
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    """Diagnose third-party install; exit non-zero on hard failures."""
    report = diagnose_install()
    print("cmux-herdr doctor")
    print("─────────────────")
    for check in report.get("checks") or []:
        name = check.get("name") or "?"
        ok = bool(check.get("ok"))
        hard = bool(check.get("hard"))
        if ok:
            mark = "ok"
        elif hard:
            mark = "FAIL"
        else:
            mark = "warn"
        print(f"[{mark:4}] {name}: {check.get('detail')}")
    if report.get("hard_failures"):
        print()
        print("hard failures:")
        for item in report["hard_failures"]:
            print(f"  - {item}")
    if args.json:
        print(json.dumps(report, indent=2, default=str))
    return 0 if report.get("ok") else 1


def cmd_tree(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        snap = fetch_snapshot()
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(
            json.dumps(
                {
                    "workspaces": [w.raw for w in snap.workspaces],
                    "tabs": [t.raw for t in snap.tabs],
                    "panes": [p.raw for p in snap.panes],
                },
                indent=2,
                default=str,
            )
        )
    else:
        print(format_tree(snap))
    return 0


def cmd_sync(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        summary = sync_to_cmux(
            workspace=args.workspace,
            clear_stale=not args.no_clear_stale,
            set_progress=not args.no_progress,
            log=not args.no_log,
        )
    except BridgeError as exc:
        _die(str(exc))
    print(summary["summary"])
    if summary.get("native_live"):
        print("writer: native (plugin projection skipped)")
    if summary.get("skipped_unchanged"):
        print(f"unchanged: {len(summary['skipped_unchanged'])} pills")
    if summary.get("stale_cleared"):
        print(f"cleared stale: {', '.join(summary['stale_cleared'])}")
    if summary.get("errors"):
        for e in summary["errors"]:
            print(f"error: {e}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(summary, indent=2, default=str))
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    if args.once:
        if getattr(args, "mirror", False) or getattr(args, "tmux_parity", False):
            return cmd_mirror(args)
        return cmd_sync(args)
    _ensure_herdr()
    interval = max(0.5, float(args.interval))
    stop = {"flag": False}

    def _handle(signum, frame):  # noqa: ARG001
        stop["flag"] = True
        print("\ncmux-herdr watch: stopping…", file=sys.stderr)

    signal.signal(signal.SIGINT, _handle)
    signal.signal(signal.SIGTERM, _handle)
    mode = "mirror+status" if getattr(args, "mirror", False) else "status"
    if getattr(args, "tmux_parity", False):
        mode = "tmux-parity"
    print(
        f"cmux-herdr watch: {mode} every {interval}s "
        f"(workspace={args.workspace or 'auto'}); Ctrl-C to stop",
        file=sys.stderr,
    )
    want_events = bool(
        getattr(args, "tmux_parity", False) or getattr(args, "events", False)
    )
    event_session = None
    live_host = None
    pump = None
    if want_events:
        event_session = HerdrEventSession.try_open(timeout=interval)
        if event_session is not None:
            print(
                "cmux-herdr watch: holding Herdr events.subscribe session",
                file=sys.stderr,
            )
    watch_note = {"text": ""}
    if getattr(args, "tmux_parity", False):
        live_host = _watch_reconcile_host(args, live_host, watch_note)
        if live_host is not None:
            pump = _make_watch_pump()
            print(
                "cmux-herdr watch: pumping pane.read / focus / agent_status "
                "into the live apply host",
                file=sys.stderr,
            )
    initial = True
    try:
        while not stop["flag"]:
            try:
                if getattr(args, "tmux_parity", False):
                    live_host = _watch_reconcile_host(args, live_host, watch_note)
                    if live_host is not None and pump is None:
                        pump = _make_watch_pump()
                    if live_host is None:
                        pump = None
                if initial:
                    if live_host is not None and pump is not None:
                        pump.poll(live_host)
                    _watch_project(args)
                    initial = False
                elif want_events:
                    event = _watch_next_event(event_session, interval)
                    if event_session is not None and event is None:
                        # Subscribe socket died (not a clean timeout).
                        if not event_session.alive():
                            event_session.close()
                            event_session = HerdrEventSession.try_open(
                                timeout=interval
                            )
                    _watch_apply_event(args, live_host, pump, event)
                else:
                    _watch_project(args)
            except BridgeError as exc:
                print(f"cmux-herdr: {exc}", file=sys.stderr)
                initial = False
            except Exception as exc:  # noqa: BLE001
                print(f"cmux-herdr: unexpected: {exc}", file=sys.stderr)
                initial = False
            if want_events:
                continue
            end = time.time() + interval
            while not stop["flag"] and time.time() < end:
                time.sleep(min(0.25, end - time.time()))
    finally:
        if live_host is not None:
            closed = live_host.detach()
            clear_host_restore(live_host.socket_path)
            release_plugin_writer(_parent_key())
            print(
                "cmux-herdr watch: detached "
                f"(server_stopped={closed.get('server_stopped')})",
                file=sys.stderr,
            )
        if pump is not None:
            pump.close()
        if event_session is not None:
            event_session.close()
    return 0


def _watch_note(note: dict, text: str) -> None:
    """Print a watch handoff line once per state, not every poll."""
    if note.get("text") == text:
        return
    note["text"] = text
    print(text, file=sys.stderr)


def _watch_reconcile_host(args: argparse.Namespace, live_host, note: dict):
    """Attach, yield to native, or resume after a stale native lease.

    Native takeover: detach the in-memory host and leave Herdr running.
    Native crash / expired heartbeat: plugin attach may resume.
    """
    decision = resolve_writer(_parent_key())
    if decision.yields:
        if live_host is not None:
            live_host.detach()
            release_plugin_writer(_parent_key())
            _watch_note(
                note,
                "cmux-herdr watch: yielded to native "
                "(Herdr session left running)",
            )
        else:
            _watch_note(
                note,
                "cmux-herdr watch: native owns this host; plugin apply idle",
            )
        return None
    if live_host is not None:
        heartbeat_plugin_writer(_parent_key())
        return live_host
    try:
        host, attached = _attach_from_snapshot(args)
    except BridgeError as exc:
        _watch_note(note, f"cmux-herdr watch: attach skipped: {exc}")
        return None
    if host is None:
        _watch_note(
            note,
            f"cmux-herdr watch: {attached.get('outcome')}; "
            "not starting a competing apply host",
        )
        return None
    outcome = (attached.get("attach") or {}).get("outcome") or attached.get("outcome")
    _watch_note(
        note,
        f"cmux-herdr watch: attached ({outcome}); "
        "Ctrl-C detaches and leaves Herdr running",
    )
    return host


def _windows_from_live_snapshot():
    """Build ``HerdrWindow`` rows from the current Herdr snapshot."""
    snap = fetch_snapshot()
    desired = desired_mirrors(snap, scope="all", use_layout=True)
    return build_herdr_windows(snap, desired)


def _make_watch_pump() -> LivePump:
    """SessionHost-style pump: one persistent RPC socket into the apply host."""
    api = HerdrApi()
    try:
        api.open()
    except Exception:
        pass
    return LivePump(
        transport=ApiTransport(api),
        windows_builder=_windows_from_live_snapshot,
    )


def _watch_next_event(event_session, interval: float):
    """Wait for one Herdr event, or ``None`` on timeout / missing socket."""
    if event_session is not None:
        return event_session.wait(timeout=interval)
    wait_herdr_event(timeout=interval)
    return None


def _watch_project(args: argparse.Namespace) -> None:
    """One cmux projection pass (mirror viewers or status pills)."""
    if getattr(args, "mirror", False) or getattr(args, "tmux_parity", False):
        result = mirror_to_cmux(
            **_mirror_kwargs(args),
            dry_run=False,
            log=False,
        )
        print(format_mirror_plan(result).splitlines()[0])
        return
    _watch_sync_pills(args)


def _watch_sync_pills(args: argparse.Namespace) -> None:
    """Refresh ``herdr:*`` status pills without rebuilding cmux viewers."""
    summary = sync_to_cmux(
        workspace=args.workspace,
        clear_stale=not args.no_clear_stale,
        set_progress=not args.no_progress,
        log=False,
    )
    print(summary["summary"])


def _watch_apply_event(args, live_host, pump, event) -> None:
    """Feed one event (or a timeout) into the apply host, then project."""
    if live_host is not None and pump is not None:
        if event is not None:
            pumped = pump.handle_event(event, live_host)
            if pumped.resync:
                _watch_project(args)
            elif pumped.status_updated:
                _watch_sync_pills(args)
            return
        pump.poll(live_host)
        _watch_project(args)
        return
    # Native owns the host, or this is status-only ``--events``.
    if event is None or getattr(args, "tmux_parity", False):
        _watch_project(args)
    else:
        _watch_sync_pills(args)


def _mirror_scope(args: argparse.Namespace) -> str:
    if getattr(args, "tmux_parity", False) or getattr(args, "all", False):
        return "all"
    if getattr(args, "herdr_workspace", None):
        return "workspace"
    return "current-tab"


def _mirror_kwargs(args: argparse.Namespace) -> dict:
    tmux_parity = bool(getattr(args, "tmux_parity", False))
    return {
        "scope": _mirror_scope(args),
        "workspace": args.workspace,
        "herdr_workspace": getattr(args, "herdr_workspace", None),
        "tab": getattr(args, "tab", None),
        "prune": True if tmux_parity else getattr(args, "prune", False),
        "sync_status": not getattr(args, "no_status", False)
        and not getattr(args, "no_progress", False),
        "use_layout": not getattr(args, "no_layout", False),
        "sync_focus": tmux_parity or getattr(args, "focus", False),
        "sync_order": tmux_parity or getattr(args, "order", False),
        "sync_ratios": tmux_parity or getattr(args, "ratios", False),
        "tmux_parity": tmux_parity,
    }


def cmd_mirror(args: argparse.Namespace) -> int:
    if is_attach_process():
        _die("refusing to nest mirror inside attach-pane")
    _ensure_herdr()
    try:
        result = mirror_to_cmux(
            **_mirror_kwargs(args),
            dry_run=getattr(args, "dry_run", False),
            log=not getattr(args, "no_log", False),
        )
    except BridgeError as exc:
        _die(str(exc))
    print(format_mirror_plan(result))
    plan = result.get("plan") if isinstance(result.get("plan"), dict) else {}
    if args.json:
        print(json.dumps(result, indent=2, default=str))
    if plan.get("errors"):
        return 2
    return 0


def cmd_attach_pane(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        return attach_pane_loop(
            args.pane_id,
            interval=max(0.05, float(args.interval)),
            lines=args.lines,
            send_input=not args.read_only,
            raw_tty=not getattr(args, "no_raw_tty", False),
            follow_resize=not getattr(args, "no_resize", False),
            ansi=not getattr(args, "no_ansi", False),
        )
    except KeyboardInterrupt:
        print("\ncmux-herdr: detached viewer", file=sys.stderr)
        return 0
    except BridgeError as exc:
        _die(str(exc))
    return 1


def cmd_send_key(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        result = send_pane_named_key(args.pane_id, args.key)
    except BridgeError as exc:
        _die(str(exc))
    print(f"sent {result.get('key')} to {result.get('pane_id')} via {result.get('via')}")
    return 0


def _attach_from_snapshot(args: argparse.Namespace):
    """Build windows from the live snapshot and attach the apply host."""
    snap = fetch_snapshot()
    desired = desired_mirrors(snap, scope="all", use_layout=True)
    windows = build_herdr_windows(snap, desired)
    socket = resolve_socket_path(getattr(args, "socket", None))
    if not socket:
        raise BridgeError(
            "need an absolute Herdr socket (--socket or HERDR_SOCKET_PATH)"
        )
    sessions = sessions_from_snapshot(snap)
    session_name = getattr(args, "session", None)
    if session_name:
        matched = [
            item
            for item in sessions
            if item.session_id == session_name or item.name == session_name
        ]
        sessions = matched or sessions
    return attach_live(
        windows,
        sessions,
        socket_path=socket,
        activate=not getattr(args, "no_activate", False),
    )


def cmd_attach(args: argparse.Namespace) -> int:
    """Attach the live apply host (tmux ``remote.tmux.attach`` analogue)."""
    _ensure_herdr()
    try:
        _host, payload = _attach_from_snapshot(args)
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(json.dumps(payload, indent=2, default=str))
    else:
        attach = payload.get("attach") if isinstance(payload.get("attach"), dict) else {}
        outcome = attach.get("outcome") or payload.get("outcome")
        if payload.get("writer") == "native" or outcome == "native_owns":
            print("native owns this host; plugin apply not started")
        else:
            print(
                f"attached {outcome} "
                f"tabs={len((payload.get('apply') or {}).get('tabs') or [])} "
                f"server_stopped={payload.get('server_stopped')}"
            )
            if payload.get("restore_path"):
                print(f"restore: {payload['restore_path']}")
    return 0 if payload.get("ok") else 2


def cmd_detach(args: argparse.Namespace) -> int:
    """Detach every live mirror. Never stops the Herdr server."""
    _ensure_herdr()
    try:
        snap = fetch_snapshot()
        desired = desired_mirrors(snap, scope="all", use_layout=True)
        windows = build_herdr_windows(snap, desired)
        socket = resolve_socket_path(getattr(args, "socket", None))
        if not socket:
            raise BridgeError(
                "need an absolute Herdr socket (--socket or HERDR_SOCKET_PATH)"
            )
        closed = detach_live(windows, socket_path=socket)
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(json.dumps(closed, indent=2, default=str))
    else:
        if closed.get("outcome") == "native_owns":
            print("native owns this host; plugin did not detach native")
        else:
            print(
                f"detached (server_stopped={closed.get('server_stopped')}; "
                "Herdr session left running)"
            )
    return 0 if closed.get("ok") else 2


def cmd_restore(args: argparse.Namespace) -> int:
    """Reattach after restart. Never replays a stale Bonsplit tree."""
    _ensure_herdr()
    try:
        snap = fetch_snapshot()
        desired = desired_mirrors(snap, scope="all", use_layout=True)
        windows = build_herdr_windows(snap, desired)
        socket = resolve_socket_path(getattr(args, "socket", None))
        if not socket:
            raise BridgeError(
                "need an absolute Herdr socket (--socket or HERDR_SOCKET_PATH)"
            )
        _host, payload = restore_live(
            windows,
            sessions_from_snapshot(snap),
            socket_path=socket,
        )
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(json.dumps(payload, indent=2, default=str))
    else:
        if payload.get("outcome") == "native_owns":
            print("native owns this host; restore stays on the native path")
        else:
            print(
                f"restore {payload.get('mode') or payload.get('outcome')} "
                f"server_stopped={payload.get('server_stopped')}"
            )
    return 0 if payload.get("ok") else 2


def cmd_observe(args: argparse.Namespace) -> int:
    _ensure_herdr()
    method = args.method
    if not method.startswith("remote.herdr."):
        method = f"remote.herdr.{method}"
    try:
        snap = fetch_snapshot()
        desired = desired_mirrors(snap, scope="all", use_layout=True)
        windows = build_herdr_windows(snap, desired)
        socket = resolve_socket_path(args.socket) or default_herdr_socket_path()
        _host, payload = observe_live(
            windows,
            socket_path=socket,
            method=method,
            session=args.session,
        )
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(json.dumps(payload, indent=2, default=str))
    else:
        print(json.dumps(payload, default=str))
    return 0 if payload.get("ok") else 2


def cmd_focus_tab(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        tid = focus_tab(args.target)
    except BridgeError as exc:
        _die(str(exc))
    print(f"focused tab {tid}")
    return 0


