    try:
        target = focus_agent(args.target)
    except BridgeError as exc:
        _die(str(exc))
    print(f"focused agent {target}")
    return 0


def _passthrough_read(proc) -> int:
    """Write herdr read stdout/stderr and return its exit code."""
    if proc.stdout:
        sys.stdout.write(proc.stdout)
        if not proc.stdout.endswith("\n"):
            sys.stdout.write("\n")
    if proc.stderr:
        sys.stderr.write(proc.stderr)
        if not proc.stderr.endswith("\n"):
            sys.stderr.write("\n")
    code = int(proc.returncode or 0)
    return code if code != 0 else 0


def cmd_read_pane(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        proc = read_pane(
            args.pane_id,
            source=args.source,
            lines=args.lines,
            format=args.format,
            ansi=args.ansi,
            raw=args.raw,
        )
    except BridgeError as exc:
        _die(str(exc))
    return _passthrough_read(proc)


def cmd_read_agent(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        proc = read_agent(
            args.target,
            source=args.source,
            lines=args.lines,
            format=args.format,
            ansi=args.ansi,
        )
    except BridgeError as exc:
        _die(str(exc))
    return _passthrough_read(proc)


def cmd_split(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        result = split_pane(args.direction)
    except BridgeError as exc:
        _die(str(exc))
    if isinstance(result, (dict, list)):
        print(json.dumps(result, indent=2, default=str))
    else:
        print(result)
    return 0


def cmd_agents(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        agents = fetch_agents()
    except BridgeError as exc:
        _die(str(exc))
    if args.json:
        print(json.dumps([a.raw for a in agents], indent=2, default=str))
        return 0
    if not agents:
        print("(no agents)")
        return 0
    for a in agents:
        mark = "▶" if a.focused else " "
        label = a.label or ""
        print(
            f"{mark} {a.pane_id:10}  {a.tab_id:8}  "
            f"{(a.agent or '-'):10}  {(a.agent_status or '?'):8}  "
            f"{label or (a.terminal_title or '')[:40]}"
        )
    return 0


def cmd_associations(args: argparse.Namespace) -> int:
    """Show hybrid pane/session association cache for this Herdr+cmux parent."""
    state = _load_association_map()
    if args.json:
        print(json.dumps(state, indent=2, default=str))
    else:
        print(format_associations(state))
    return 0


def cmd_lock_title(args: argparse.Namespace) -> int:
    """Lock a pane display name so later syncs do not overwrite it."""
    try:
        entry = set_title_lock(args.pane_id, locked=True, title=args.title)
    except BridgeError as exc:
        _die(str(exc))
    print(
        f"locked title for {entry.get('pane_id')}: "
        f"{entry.get('locked_title') or '-'}"
    )
    return 0


def cmd_unlock_title(args: argparse.Namespace) -> int:
    """Clear the native-title lock so sync may update the display name."""
    try:
        entry = set_title_lock(args.pane_id, locked=False)
    except BridgeError as exc:
        _die(str(exc))
    print(f"unlocked title for {entry.get('pane_id')}")
    return 0


def cmd_clear(args: argparse.Namespace) -> int:
    try:
        cleared = clear_cmux_herdr_statuses(args.workspace)
    except BridgeError as exc:
        _die(str(exc))
    if cleared:
        print(f"cleared {len(cleared)} status keys:")
        for k in cleared:
            print(f"  {k}")
    else:
        print("no herdr:* status keys to clear")
    return 0


def cmd_json_dump(args: argparse.Namespace) -> int:
    _ensure_herdr()
    try:
        snap = fetch_snapshot()
    except BridgeError as exc:
        _die(str(exc))
    payload = {
        "fetched_at": snap.fetched_at,
        "env": {
            "HERDR_ENV": os.environ.get("HERDR_ENV"),
            "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
            "HERDR_TAB_ID": os.environ.get("HERDR_TAB_ID"),
            "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
            "HERDR_SOCKET_PATH": os.environ.get("HERDR_SOCKET_PATH"),
            "CMUX_SURFACE_ID": os.environ.get("CMUX_SURFACE_ID"),
            "CMUX_TAB_ID": os.environ.get("CMUX_TAB_ID"),
            "CMUX_WORKSPACE_ID": os.environ.get("CMUX_WORKSPACE_ID"),
            "CMUX_SOCKET_PATH": os.environ.get("CMUX_SOCKET_PATH"),
        },
        "cmux_resolved_workspace": None,
        "workspaces": [w.raw for w in snap.workspaces],
        "tabs": [t.raw for t in snap.tabs],
        "panes": [p.raw for p in snap.panes],
    }
    try:
        payload["cmux_resolved_workspace"] = resolve_cmux_workspace()
    except Exception as exc:  # noqa: BLE001
        payload["cmux_resolve_error"] = str(exc)
    print(json.dumps(payload, indent=2, default=str))
    return 0


_CLI_API: Optional[HerdrApi] = None


def _api() -> HerdrApi:
    """Process-wide socket-first caller. Control talks to Herdr even if native owns chrome."""
    global _CLI_API
    if _CLI_API is not None:
        return _CLI_API
    api = HerdrApi()
    try:
        api.open()
    except Exception:
        pass
    _CLI_API = api
    return api


def _print_api(result, args: argparse.Namespace, *, line: Optional[str] = None) -> int:
    """Print a short line and/or the JSON RPC payload."""
    if line and not getattr(args, "json", False):
        print(line)
    if getattr(args, "json", False) or not line:
        print(json.dumps(result.to_dict(), indent=2, default=str))
    return 0 if result.ok else 2


def _run_api(
    args: argparse.Namespace,
    method: str,
    params: Optional[dict] = None,
    *,
    line: Optional[str] = None,
) -> int:
    """Call an allowlisted Herdr method and print the result."""
    try:
        result = _api().call(method, params or {})
    except (ApiError, BridgeError) as exc:
        _die(str(exc))
    return _print_api(result, args, line=line)


def cmd_api(args: argparse.Namespace) -> int:
    """Generic allowlisted RPC. Refuses ``server.stop`` before any I/O."""
    if getattr(args, "list", False):
        for name in sorted(ALLOWED_METHODS):
            print(name)
        return 0
    method = getattr(args, "method", None)
    if not method:
        _die("api: pass a method or --list")
    params = {}
    raw = getattr(args, "params", None)
    if raw:
        try:
            loaded = json.loads(raw)
        except json.JSONDecodeError as exc:
            _die(f"invalid --params JSON: {exc}")
        if loaded is None:
            params = {}
        elif not isinstance(loaded, dict):
            _die("--params must be a JSON object")
        else:
            params = loaded
    return _run_api(args, method, params)


def cmd_new_tab(args: argparse.Namespace) -> int:
    """Create a Herdr tab (socket ``tab.create``)."""
    params = {}
    if args.label:
        params["label"] = args.label
    if args.workspace:
        params["workspace_id"] = args.workspace
    return _run_api(args, "tab.create", params, line="created tab")


def cmd_close_tab(args: argparse.Namespace) -> int:
    """Close a Herdr tab. Does not stop the server."""
    return _run_api(
        args, "tab.close", {"tab_id": args.tab_id}, line=f"closed tab {args.tab_id}"
    )


def cmd_rename_tab(args: argparse.Namespace) -> int:
    """Rename a Herdr tab."""
    return _run_api(
        args,
        "tab.rename",
        {"tab_id": args.tab_id, "label": args.label},
        line=f"renamed tab {args.tab_id}",
    )


def cmd_new_workspace(args: argparse.Namespace) -> int:
    """Create a Herdr workspace."""
    params = {}
    if args.label:
        params["label"] = args.label
    if args.cwd:
        params["cwd"] = args.cwd
    return _run_api(args, "workspace.create", params, line="created workspace")


def cmd_close_workspace(args: argparse.Namespace) -> int:
    """Close a Herdr workspace. Does not call ``server.stop``."""
    return _run_api(
        args,
        "workspace.close",
        {"workspace_id": args.workspace_id},
        line=f"closed workspace {args.workspace_id}",
    )


def cmd_rename_workspace(args: argparse.Namespace) -> int:
    """Rename a Herdr workspace."""
    return _run_api(
        args,
        "workspace.rename",
        {"workspace_id": args.workspace_id, "label": args.label},
        line=f"renamed workspace {args.workspace_id}",
    )


def cmd_close_pane(args: argparse.Namespace) -> int:
    """Close a Herdr pane. Busy panes need ``--force`` (tmux busy-close)."""
    _ensure_herdr()
    try:
        if not args.force:
            info = _api().call("pane.get", {"pane_id": args.pane_id})
            status = extract_agent_status(info.result)
            intent = close_intent(
                "user_pane", pane_id=args.pane_id, agent_status=status
            )
            if intent.action == "confirm_then_close_pane":
                _die(
                    f"pane {args.pane_id} is busy (agent_status={status}); "
                    "pass --force to close"
                )
        return _run_api(
            args,
            "pane.close",
            {"pane_id": args.pane_id, "force": bool(args.force)},
            line=f"closed pane {args.pane_id}",
        )
    except (ApiError, BridgeError) as exc:
        _die(str(exc))
    return 1


def cmd_zoom_pane(args: argparse.Namespace) -> int:
    """Zoom or unzoom a pane (``pane.zoom``)."""
    params = {"mode": args.mode}
    if args.pane_id:
        params["pane_id"] = args.pane_id
    return _run_api(args, "pane.zoom", params, line=f"zoom {args.mode}")


def cmd_resize_pane(args: argparse.Namespace) -> int:
    """Resize a pane (``pane.resize``)."""
    params = {"direction": args.direction, "amount": args.amount}
    if args.pane_id:
        params["pane_id"] = args.pane_id
    return _run_api(args, "pane.resize", params, line="resized pane")


def cmd_swap_pane(args: argparse.Namespace) -> int:
    """Swap two panes in the same tab."""
    params = {}
    if args.pane_id:
        params["pane_id"] = args.pane_id
    if args.target:
        params["source_pane_id"] = args.pane_id
        params["target_pane_id"] = args.target
    if args.direction:
        params["direction"] = args.direction
    return _run_api(args, "pane.swap", params, line="swapped pane")


def cmd_send(args: argparse.Namespace) -> int:
    """Send text to a pane (``pane.send_text``)."""
    text = " ".join(args.text)
    return _run_api(
        args,
        "pane.send_text",
        {"pane_id": args.pane_id, "text": text},
        line=f"sent text to {args.pane_id}",
    )


def cmd_neighbor(args: argparse.Namespace) -> int:
    """Look up the neighboring pane (``pane.neighbor``)."""
    params = {"direction": args.direction}
    if args.pane_id:
        params["pane_id"] = args.pane_id
    return _run_api(args, "pane.neighbor", params)


def cmd_layout(args: argparse.Namespace) -> int:
    """Export a tab layout tree (``layout.export``)."""
    params = {}
    if args.tab:
        params["tab_id"] = args.tab
    if args.pane:
        params["pane_id"] = args.pane
    return _run_api(args, "layout.export", params)


def cmd_set_ratio(args: argparse.Namespace) -> int:
    """Update a split ratio (``layout.set_split_ratio``)."""
    path: list = []
    if args.path:
        try:
            loaded = json.loads(args.path)
        except json.JSONDecodeError as exc:
            _die(f"invalid --path JSON: {exc}")
        if not isinstance(loaded, list):
            _die("--path must be a JSON array of hop indexes")
        path = loaded
    params = {"ratio": args.ratio, "path": path}
    if args.tab:
        params["tab_id"] = args.tab
    return _run_api(args, "layout.set_split_ratio", params, line="set split ratio")


def cmd_move_pane(args: argparse.Namespace) -> int:
    """Move a running pane to another tab (``pane.move``)."""
    if args.new_tab:
        destination = {"type": "new_tab", "label": args.label or "moved"}
        if args.workspace:
            destination["workspace_id"] = args.workspace
    elif args.tab:
        destination = {"type": "tab", "tab_id": args.tab, "split": args.split}
        if args.target:
            destination["target_pane_id"] = args.target
    else:
        _die("move-pane: pass --tab or --new-tab")
    params = {
        "pane_id": args.pane_id,
        "destination": destination,
        "focus": not args.no_focus,
    }
    return _run_api(args, "pane.move", params, line=f"moved {args.pane_id}")


def cmd_focus_dir(args: argparse.Namespace) -> int:
    """Focus the neighboring pane (``pane.focus_direction``)."""
    return _run_api(
        args,
        "pane.focus_direction",
        {"direction": args.direction},
        line=f"focus {args.direction}",
    )


def cmd_move_tab(args: argparse.Namespace) -> int:
    """Move a tab in the strip or to another workspace (``tab.move``)."""
    params: dict = {"tab_id": args.tab_id}
    if args.index is not None:
        params["index"] = args.index
    if args.workspace:
        params["workspace_id"] = args.workspace
    return _run_api(args, "tab.move", params, line=f"moved tab {args.tab_id}")


def cmd_rename_pane(args: argparse.Namespace) -> int:
    """Rename a Herdr pane (``pane.rename``)."""
    return _run_api(
        args,
        "pane.rename",
        {"pane_id": args.pane_id, "label": args.label},
        line=f"renamed pane {args.pane_id}",
    )


def cmd_rename_agent(args: argparse.Namespace) -> int:
    """Rename a Herdr agent (``agent.rename``)."""
    return _run_api(
        args,
        "agent.rename",
        {"pane_id": args.target, "target": args.target, "label": args.label},
        line=f"renamed agent {args.target}",
    )


def cmd_start_agent(args: argparse.Namespace) -> int:
    """Start an agent in a pane (``agent.start``)."""
    params: dict = {"pane_id": args.pane_id, "target": args.pane_id}
    if args.agent:
        params["agent"] = args.agent
    return _run_api(
        args, "agent.start", params, line=f"started agent on {args.pane_id}"
    )


def cmd_notify(args: argparse.Namespace) -> int:
    """Show a Herdr notification (``notification.show``)."""
    params: dict = {"title": args.title}
    if args.body:
        params["body"] = args.body
    return _run_api(args, "notification.show", params, line="notified")


def cmd_wait_output(args: argparse.Namespace) -> int:
    """Wait for pane output (``pane.wait_for_output``)."""
    params: dict = {"pane_id": args.pane_id, "pattern": args.pattern}
    if args.timeout_ms is not None:
        params["timeout_ms"] = args.timeout_ms
    return _run_api(
        args,
        "pane.wait_for_output",
        params,
        line=f"wait output {args.pane_id}",
    )


def cmd_agent_prompt(args: argparse.Namespace) -> int:
    """Submit an agent prompt (optional wait in the same RPC)."""
    params: dict = {"target": args.target, "prompt": " ".join(args.prompt)}
    # Herdr also accepts pane_id; send both so CLI fallback can resolve.
    params["pane_id"] = args.target
    if args.until:
        wait: dict = {"until": args.until}
        if args.timeout_ms is not None:
            wait["timeout_ms"] = args.timeout_ms
        params["wait"] = wait
        params["until"] = args.until
    return _run_api(args, "agent.prompt", params, line=f"prompted {args.target}")


def cmd_agent_wait(args: argparse.Namespace) -> int:
    """Wait for semantic agent state (``agent.wait``)."""
    params = {"target": args.target, "pane_id": args.target, "until": args.until}
    if args.timeout_ms is not None:
        params["timeout_ms"] = args.timeout_ms
    return _run_api(args, "agent.wait", params, line=f"wait {args.until} {args.target}")


def _add_read_flags(sp: argparse.ArgumentParser, *, include_raw: bool) -> None:
    """Shared flags for read-pane / read-agent (herdr pass-through)."""
    sp.add_argument(
        "--source",
        choices=("visible", "recent", "recent-unwrapped", "detection"),
        help="herdr read source (default: herdr's own default)",
    )
    sp.add_argument(
        "--lines",
        type=int,
        help="limit to last N lines/rows (herdr --lines)",
    )
    sp.add_argument(
        "--format",
        choices=("text", "ansi"),
        help="output format (herdr --format)",
    )
    sp.add_argument(
        "--ansi",
        action="store_true",
        help="preserve ANSI (herdr --ansi)",
    )
    if include_raw:
        sp.add_argument(
            "--raw",
            action="store_true",
            help="raw ANSI without stripping (herdr pane read --raw)",
        )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cmux-herdr",
        description="Bridge herdr agent/tab state into cmux (user plugin, no upstream PR).",
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"cmux-herdr {_read_version()}",
    )
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("status", help="Show dual cmux+herdr context")
    s.add_argument("--json", action="store_true", help="Also print raw JSON blob")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser(
        "doctor",
        help="Diagnose third-party install (herdr, socket, fingerprint, LaunchAgent, sidebar)",
    )
    s.add_argument("--json", action="store_true", help="Also print raw JSON report")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("tree", help="Pretty-print herdr workspaces/tabs/panes/agents")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_tree)

    def add_sync_flags(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--workspace",
            help="cmux workspace id/ref (default: auto-resolve)",
        )
        sp.add_argument(
            "--no-clear-stale",
            action="store_true",
            help="Do not remove herdr:* keys for gone panes",
        )
        sp.add_argument(
            "--no-progress",
            action="store_true",
            help="Do not update cmux set-progress",
        )
        sp.add_argument(
            "--no-log",
            action="store_true",
            help="Do not cmux log summary line",
        )
        sp.add_argument("--json", action="store_true")

    def add_mirror_flags(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--all",
            action="store_true",
            help="Mirror every Herdr tab/pane (ssh-tmux-style full session)",
        )
        sp.add_argument(
            "--herdr-workspace",
            help="Mirror every tab in this Herdr workspace id (e.g. w2)",
        )
        sp.add_argument(
            "--tab",
            help="Herdr tab id to mirror (default: $HERDR_TAB_ID)",
        )
        sp.add_argument(
            "--prune",
            action="store_true",
            help="Close cmux surfaces whose Herdr panes are gone",
        )
        sp.add_argument(
            "--dry-run",
            action="store_true",
            help="Print the reconcile plan without creating/closing surfaces",
        )
        sp.add_argument(
            "--no-status",
            action="store_true",
            help="Do not also write herdr:* status pills",
        )
        sp.add_argument(
            "--tmux-parity",
            action="store_true",
            help=(
                "Maximum ssh-tmux contract: --all --prune plus layout ratios, "
                "tab order, and focus sync"
            ),
        )
        sp.add_argument(
            "--focus",
            action="store_true",
            help="Project Herdr focused pane onto the matching cmux surface",
        )
        sp.add_argument(
            "--order",
            action="store_true",
            help="Reorder cmux tabs to match Herdr tab numbers",
        )
        sp.add_argument(
            "--ratios",
            action="store_true",
            help="Impose layout-tree split ratios on existing cmux splits",
        )
        sp.add_argument(
            "--no-layout",
            action="store_true",
            help="Do not use Herdr layout trees (alternate right/down splits)",
        )

    s = sub.add_parser("sync", help="One-shot mirror herdr agents → cmux set-status")
    add_sync_flags(s)
    s.set_defaults(func=cmd_sync)

    s = sub.add_parser("watch", help="Loop sync every N seconds (default 3)")
    add_sync_flags(s)
    add_mirror_flags(s)
    s.add_argument(
        "-n",
        "--interval",
        type=float,
        default=3.0,
        help="Seconds between syncs (default 3)",
    )
    s.add_argument(
        "--once",
        action="store_true",
        help="Alias for sync (single iteration)",
    )
    s.add_argument(
        "--mirror",
        action="store_true",
        help="Also reconcile Herdr tabs/panes into cmux tabs/splits",
    )
    s.add_argument(
        "--events",
        action="store_true",
        help="Prefer Herdr Unix-socket events between polls (tmux-parity default)",
    )
    s.set_defaults(func=cmd_watch)

    s = sub.add_parser(
        "mirror",
        help="Project Herdr tabs/panes into real cmux tabs/splits (userspace ssh-tmux analogue)",
    )
    add_sync_flags(s)
    add_mirror_flags(s)
    s.set_defaults(func=cmd_mirror)

    s = sub.add_parser(
        "attach-pane",
        help="Follow one Herdr pane in this terminal (used by mirror surfaces)",
    )
    s.add_argument("pane_id")
    s.add_argument(
        "-n",
        "--interval",
        type=float,
        default=0.25,
        help="Refresh interval seconds (default 0.25)",
    )
    s.add_argument(
        "--lines",
        type=int,
        default=200,
        help="Lines to read from herdr pane read (default 200)",
    )
    s.add_argument(
        "--read-only",
        action="store_true",
        help="Do not forward typed input to the Herdr pane",
    )
    s.add_argument(
        "--no-raw-tty",
        action="store_true",
        help="Do not put stdin in cbreak (line-buffered input)",
    )
    s.add_argument(
        "--no-resize",
        action="store_true",
        help="Do not forward SIGWINCH to herdr pane resize",
    )
    s.add_argument(
        "--no-ansi",
        action="store_true",
        help="Do not request ANSI/raw pane read",
    )
    s.set_defaults(func=cmd_attach_pane)

    s = sub.add_parser("focus-tab", help="Focus herdr tab by id or label")
    s.add_argument("target", help="tab_id or label")
    s.set_defaults(func=cmd_focus_tab)

    s = sub.add_parser(
        "focus-pane",
        help="Focus herdr pane by id (via herdr agent focus; no zoom fallback)",
    )
    s.add_argument("pane_id")
    s.set_defaults(func=cmd_focus_pane)

    s = sub.add_parser("focus-workspace", help="Focus herdr workspace by id")
    s.add_argument("workspace_id")
    s.set_defaults(func=cmd_focus_workspace)

    s = sub.add_parser("focus-agent", help="Focus herdr agent by pane id or label")
    s.add_argument("target", help="pane_id or agent label")
    s.set_defaults(func=cmd_focus_agent)

    s = sub.add_parser(
        "read-pane",
        help="Read herdr pane output (thin wrapper over herdr pane read)",
    )
    s.add_argument("pane_id")
    _add_read_flags(s, include_raw=True)
    s.set_defaults(func=cmd_read_pane)

    s = sub.add_parser(
        "read-agent",
        help="Read herdr agent output (thin wrapper over herdr agent read)",
    )
    s.add_argument("target", help="pane_id or agent label")
    _add_read_flags(s, include_raw=False)
    s.set_defaults(func=cmd_read_agent)

    s = sub.add_parser("split", help="Split current herdr pane")
    s.add_argument(
        "--direction",
        choices=("right", "down"),
        default="right",
    )
    s.set_defaults(func=cmd_split)

    s = sub.add_parser("agents", help="List herdr agents compactly")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_agents)

    s = sub.add_parser(
        "associations",
        help="Show hybrid pane/session association cache (parent map + status keys)",
    )
    s.add_argument("--json", action="store_true", help="machine-readable output")
    s.set_defaults(func=cmd_associations)

    s = sub.add_parser(
        "lock-title",
        help="Lock a pane display name (native-title lock; sync will not overwrite it)",
    )
    s.add_argument("pane_id")
    s.add_argument("--title", help="display name to lock (default: cached label or pane id)")
    s.set_defaults(func=cmd_lock_title)

    s = sub.add_parser(
        "unlock-title",
        help="Clear the native-title lock so sync may update the display name",
    )
    s.add_argument("pane_id")
    s.set_defaults(func=cmd_unlock_title)

    s = sub.add_parser("clear", help="Clear all cmux statuses with herdr: prefix")
    s.add_argument("--workspace", help="cmux workspace id/ref")
    s.set_defaults(func=cmd_clear)

    s = sub.add_parser("json-dump", help="Raw snapshot for debugging")
    s.set_defaults(func=cmd_json_dump)

    s = sub.add_parser(
        "send-key",
        help="Send a tmux-style named key (C-Up, F5, PPage) to one Herdr pane",
    )
    s.add_argument("pane_id")
    s.add_argument("key")
    s.set_defaults(func=cmd_send_key)

    s = sub.add_parser(
        "observe",
        help="remote.herdr.* observability (pane_surfaces / pane_grids / state)",
    )
    s.add_argument(
        "--method",
        default="remote.herdr.pane_surfaces",
        help="remote.herdr.pane_surfaces | pane_grids | state",
    )
    s.add_argument(
        "--socket",
        help="Herdr Unix socket (default: HERDR_SOCKET_PATH or the default path)",
    )
    s.add_argument("--session", default="main")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_observe)

    def add_lifecycle_flags(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--socket",
            help="Herdr Unix socket (default: HERDR_SOCKET_PATH or the default path)",
        )
        sp.add_argument("--session", help="Herdr session / workspace id")
        sp.add_argument("--json", action="store_true")

    s = sub.add_parser(
        "attach",
        help="Attach the live apply host (tmux remote.tmux.attach analogue)",
    )
    add_lifecycle_flags(s)
    s.add_argument(
        "--no-activate",
        action="store_true",
        help="Do not mark the destination window active",
    )
    s.set_defaults(func=cmd_attach)

    s = sub.add_parser(
        "detach",
        help="Detach every live mirror; never stops the Herdr server",
    )
    add_lifecycle_flags(s)
    s.set_defaults(func=cmd_detach)

    s = sub.add_parser(
        "restore",
        help="Reattach after restart (never replay a stale tree)",
    )
    add_lifecycle_flags(s)
    s.set_defaults(func=cmd_restore)

    s = sub.add_parser(
        "api",
        help="Allowlisted Herdr socket RPC (CLI fallback; never server.stop)",
    )
    s.add_argument("method", nargs="?", help="dot method, e.g. pane.close")
    s.add_argument(
        "--params",
        help="JSON object of method params",
    )
    s.add_argument(
        "--list",
        action="store_true",
        help="Print allowlisted methods and exit",
    )
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_api)

    s = sub.add_parser("new-tab", help="Create a Herdr tab (tab.create)")
    s.add_argument("--label")
    s.add_argument("--workspace", dest="workspace")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_new_tab)

    s = sub.add_parser("close-tab", help="Close a Herdr tab (never stops Herdr)")
    s.add_argument("tab_id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_close_tab)

    s = sub.add_parser("rename-tab", help="Rename a Herdr tab")
    s.add_argument("tab_id")
    s.add_argument("label")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_rename_tab)

    s = sub.add_parser("new-workspace", help="Create a Herdr workspace")
    s.add_argument("--label")
    s.add_argument("--cwd")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_new_workspace)

    s = sub.add_parser(
        "close-workspace",
        help="Close a Herdr workspace (never server.stop)",
    )
    s.add_argument("workspace_id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_close_workspace)

    s = sub.add_parser("rename-workspace", help="Rename a Herdr workspace")
    s.add_argument("workspace_id")
    s.add_argument("label")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_rename_workspace)

    s = sub.add_parser(
        "close-pane",
        help="Close a Herdr pane (busy panes require --force)",
    )
    s.add_argument("pane_id")
    s.add_argument(
        "--force",
        action="store_true",
        help="Close even when agent_status is working/blocked",
    )
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_close_pane)

    s = sub.add_parser("zoom-pane", help="Zoom or unzoom a Herdr pane")
    s.add_argument("pane_id", nargs="?")
    s.add_argument(
        "--mode",
        choices=("toggle", "on", "off"),
        default="toggle",
    )
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_zoom_pane)

    s = sub.add_parser("resize-pane", help="Resize a Herdr pane")
    s.add_argument("pane_id", nargs="?")
    s.add_argument(
        "--direction",
        choices=("right", "left", "up", "down"),
        required=True,
    )
    s.add_argument("--amount", type=float, default=0.1)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_resize_pane)

    s = sub.add_parser("swap-pane", help="Swap panes in the same Herdr tab")
    s.add_argument("pane_id", nargs="?")
    s.add_argument("--direction", choices=("right", "left", "up", "down"))
    s.add_argument("--target", help="explicit target pane id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_swap_pane)

    s = sub.add_parser("send", help="Send text to a Herdr pane (pane.send_text)")
    s.add_argument("pane_id")
    s.add_argument("text", nargs="+")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_send)

    s = sub.add_parser("neighbor", help="Look up a neighboring Herdr pane")
    s.add_argument("pane_id", nargs="?")
    s.add_argument(
        "--direction",
        choices=("right", "left", "up", "down"),
        default="right",
    )
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_neighbor)

    s = sub.add_parser("layout", help="Export a Herdr tab layout tree")
    s.add_argument("--tab")
    s.add_argument("--pane")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_layout)

    s = sub.add_parser("set-ratio", help="Set a tab split ratio (layout.set_split_ratio)")
    s.add_argument("--tab")
    s.add_argument("--ratio", type=float, required=True)
    s.add_argument(
        "--path",
        help='JSON array of split hops, e.g. [] or [0]',
    )
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_set_ratio)

    s = sub.add_parser("move-pane", help="Move a running pane to another tab")
    s.add_argument("pane_id")
    s.add_argument("--tab", help="destination tab id")
    s.add_argument("--new-tab", action="store_true", help="move into a new tab")
    s.add_argument("--label", help="label for --new-tab")
    s.add_argument("--workspace", help="workspace for --new-tab")
    s.add_argument("--split", choices=("right", "down"), default="right")
    s.add_argument("--target", help="target pane in the destination tab")
    s.add_argument("--no-focus", action="store_true")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_move_pane)

    s = sub.add_parser("focus-dir", help="Focus a neighboring pane (pane.focus_direction)")
    s.add_argument(
        "direction",
        choices=("right", "left", "up", "down"),
    )
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_focus_dir)

    s = sub.add_parser("move-tab", help="Move a Herdr tab (tab.move)")
    s.add_argument("tab_id")
    s.add_argument("--index", type=int, help="new index in the tab strip")
    s.add_argument("--workspace", help="destination workspace id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_move_tab)

    s = sub.add_parser("rename-pane", help="Rename a Herdr pane (pane.rename)")
    s.add_argument("pane_id")
    s.add_argument("label")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_rename_pane)

    s = sub.add_parser("rename-agent", help="Rename a Herdr agent (agent.rename)")
    s.add_argument("target")
    s.add_argument("label")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_rename_agent)

    s = sub.add_parser("start-agent", help="Start an agent in a pane (agent.start)")
    s.add_argument("pane_id")
    s.add_argument("--agent", help="agent id / manifest name")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_start_agent)

    s = sub.add_parser("notify", help="Show a Herdr notification (notification.show)")
    s.add_argument("title")
    s.add_argument("--body")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_notify)

    s = sub.add_parser(
        "wait-output", help="Wait for pane output (pane.wait_for_output)"
    )
    s.add_argument("pane_id")
    s.add_argument("pattern")
    s.add_argument("--timeout-ms", type=int)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_wait_output)

    s = sub.add_parser(
        "agent-prompt",
        help="Submit an agent prompt (optional --until wait)",
    )
    s.add_argument("target", help="pane id or agent label")
    s.add_argument("prompt", nargs="+")
    s.add_argument("--until", help="wait until this agent_status")
    s.add_argument("--timeout-ms", type=int)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_agent_prompt)

    s = sub.add_parser("agent-wait", help="Wait for semantic agent state")
    s.add_argument("target", help="pane id or agent label")
    s.add_argument("--until", default="done")
    s.add_argument("--timeout-ms", type=int)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_agent_wait)

    return p


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
